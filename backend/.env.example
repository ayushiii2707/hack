# ============================ infra ============================
# SQLite for local dev; PostgreSQL for production:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/checkout_copilot
DATABASE_URL=sqlite:///./checkout_copilot.db
ENVIRONMENT=development            # development | staging | production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=*                    # explicit host list in production, e.g. app.example.com
ROOT_PATH=                         # set if served under a path prefix by a proxy
LOG_LEVEL=INFO
LOG_JSON=false                     # true for structured JSON logs in production

# ======================= identity / security ==================
# REQUIRED in production (>= 32 chars). A random key is used in dev if unset.
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL_HOURS=72
SESSION_COOKIE_SECURE=false        # true behind HTTPS (production)
SESSION_COOKIE_SAMESITE=lax
# Optional. Enables /audit/admin and /products/sync. Leave blank to disable them.
ADMIN_API_KEY=
# Deterministic demo failure endpoint. MUST be false in production.
ENABLE_DEMO_ENDPOINTS=false

# ============================ Gemini ==========================
# https://aistudio.google.com/app/apikey — optional; a deterministic keyword
# router is used when unset (same tools + policies). Key format: AIza... (a
# Google AI Studio key), or a valid v1beta bearer token.
GEMINI_API_KEY=
# Must be a currently-available model with function calling. Google retires
# older names; if the API returns 404 NOT_FOUND, pick a newer one from
# GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# ====================== Razorpay Test Mode ====================
# Dashboard -> Settings -> API Keys (Test Mode). Key id starts with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. REQUIRED once Razorpay keys are set —
# unsigned webhooks are rejected, and the app refuses to start without it in prod.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=15

# ======================= external catalog =====================
CATALOG_BASE_URL=https://dummyjson.com
CATALOG_SYNC_LIMIT=200
# DummyJSON prices are small USD floats; 35 keeps footwear ~2,000-3,500 INR.
CATALOG_PRICE_MULTIPLIER=35
CATALOG_SYNC_PRESERVE_LOCAL_STOCK=true

# ================= commerce policy (PAISE) ====================
MAX_ITEM_QUANTITY=5
UPSELL_PRICE_CAP_PERCENT=20
SHIPPING_FEE=500
FREE_SHIPPING_THRESHOLD=200000
AGENT_PRODUCT_CONTEXT_LIMIT=5
AGENT_MAX_TOOL_ITERATIONS=12

# ===================== rate limiting =========================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AGENT_PER_MINUTE=15
RATE_LIMIT_PAYMENT_PER_MINUTE=20
RATE_LIMIT_SESSION_CREATE_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=300
RATE_LIMIT_SEARCH_PER_MINUTE=60
