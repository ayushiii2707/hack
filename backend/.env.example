# ---- infra ----
DATABASE_URL=sqlite:///./checkout_copilot.db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Gemini (LLM) ----
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Razorpay Test Mode ----
# Dashboard -> Settings -> API Keys (Test Mode). Key id starts with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- external catalog ----
CATALOG_BASE_URL=https://dummyjson.com

# ---- commerce policy (money values are in PAISE) ----
MAX_ITEM_QUANTITY=5
UPSELL_PRICE_CAP_PERCENT=20
SHIPPING_FEE=500
FREE_SHIPPING_THRESHOLD=200000
CATALOG_SYNC_LIMIT=200
AGENT_PRODUCT_CONTEXT_LIMIT=5
# DummyJSON prices are small USD floats; this multiplier turns them into
# realistic INR amounts (35 keeps footwear in the ~2,000-3,500 range).
CATALOG_PRICE_MULTIPLIER=35
